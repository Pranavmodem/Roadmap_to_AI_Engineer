# ── AI teacher (optional — the site fully works without it; the teacher
#    panel shows a friendly setup message until these are set) ────────────
# Any OpenAI-compatible chat-completions endpoint works.
#
# Recommended: OpenRouter (one key, many models)
#   AI_API_URL=https://openrouter.ai/api
#   AI_MODEL=anthropic/claude-sonnet-5
#
# Or Anthropic-compatible gateways, or a local server (LM Studio/Ollama with
# an OpenAI-compatible endpoint):
#   AI_API_URL=http://localhost:11434
#   AI_MODEL=llama3.1
AI_API_KEY=
AI_API_URL=https://openrouter.ai/api
AI_MODEL=anthropic/claude-sonnet-5
# Optional second model to try when the primary errors/rate-limits:
AI_FALLBACK_MODEL=
